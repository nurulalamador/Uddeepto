NODE_ENV=production
# Render sets PORT itself. Locally the server uses 4000, the same port as ../backend.
# PORT=4000

DATABASE_URL=
DATABASE_SSL=true
# Keep this small on a 512 MB host (all queries share one pool)
DB_POOL_MAX=5

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Comma separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Requests per minute per client IP
RATE_LIMIT_PER_MINUTE=180

MAX_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=500
MAX_DOCUMENT_UPLOAD_MB=50
MAX_OTHER_UPLOAD_MB=100
# Where course-material and contest uploads are stored. Empty = ./uploads
# (or ../backend/uploads when that folder exists locally).
UPLOAD_DIR=

# AI Assistant (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_REQUESTS_PER_MINUTE=12
