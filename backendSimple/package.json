{
  "name": "uddeepto-backend-simple",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Single-process Uddeepto backend: same /api/v1 API as ../backend, built for small hosts such as Render.",
  "scripts": {
    "dev": "node --watch src/server.js",
