NODE_ENV=development
DATABASE_URL=
DATABASE_SSL=true
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Public entry point: the load balancer listens here and spreads requests over the gateway copies.
LB_PORT=4000
GATEWAY_URLS=http://localhost:4101,http://localhost:4102
# round-robin or least-connections
LB_STRATEGY=round-robin
# Optional: token for GET /lb/status (header x-lb-token). Without it only localhost may read it.
LB_STATUS_TOKEN=
# Used only when a gateway is started on its own, without --port
GATEWAY_PORT=4000
# Where other services send live updates (the process that owns the sockets)
FRONTEND_API_URL=http://localhost:4010
AUTH_PORT=4001
USERS_PORT=4002
COURSES_PORT=4003
COMMUNITY_PORT=4004
CONTESTS_PORT=4005
WEBINARS_PORT=4006
JOBS_PORT=4007
MESSAGES_PORT=4008
PAYMENTS_PORT=4009
AUTH_URL=http://localhost:4001
USERS_URL=http://localhost:4002
COURSES_URL=http://localhost:4003
COMMUNITY_URL=http://localhost:4004
CONTESTS_URL=http://localhost:4005
WEBINARS_URL=http://localhost:4006
JOBS_URL=http://localhost:4007
MESSAGES_URL=http://localhost:4008
PAYMENTS_URL=http://localhost:4009
MAX_UPLOAD_MB=10
# AI Assistant (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_REQUESTS_PER_MINUTE=12
UPLOAD_DIR=
MAX_VIDEO_UPLOAD_MB=500
MAX_DOCUMENT_UPLOAD_MB=50
MAX_OTHER_UPLOAD_MB=100
