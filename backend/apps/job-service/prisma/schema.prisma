generator client {
  provider   = "prisma-client-js"
  output     = "../generated/client"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["jobs"]
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE

  @@schema("jobs")
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED

  @@schema("jobs")
}

model Job {
  id           String    @id @default(uuid()) @db.Uuid
  title        String    @db.VarChar(180)
  company      String    @db.VarChar(180)
  location     String?   @db.VarChar(180)
  type         JobType
  description  String    @db.Text
  requirements String?   @db.Text
  salaryMin    Int?
  salaryMax    Int?
  currency     String    @default("BDT") @db.VarChar(10)
  applyUrl     String?   @db.Text
  deadline     DateTime?
  status       JobStatus @default(DRAFT)
  postedById   String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([company])
  @@index([type])

  @@schema("jobs")
}
